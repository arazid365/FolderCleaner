<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtPermissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnGrantPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant All Files Access" />

        <View android:layout_width="match_parent" android:layout_height="16dp" />

        <Button
            android:id="@+id/btnAddDownloads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Watch: Download folder" />

        <Button
            android:id="@+id/btnAddScreenshots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Watch: Screenshots folder" />

        <EditText
            android:id="@+id/editCustomPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="/storage/emulated/0/YourFolder"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAddCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Watch custom path" />

        <View android:layout_width="match_parent" android:layout_height="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Watched folders:"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/listFolders"
            android:layout_width="match_parent"
            android:layout_height="150dp" />

        <View android:layout_width="match_parent" android:layout_height="16dp" />

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start watching" />

        <Button
            android:id="@+id/btnStopService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop watching" />

    </LinearLayout>
</ScrollView>
